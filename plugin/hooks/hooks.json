{
  "description": "Inject Herald's concise written-summary and attention-event speech guidance.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks-handlers/session-start.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
